{
  "name": "posawesome-frontend",
  "private": true,
  "version": "16.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --noEmit && vite build --base=/assets/posawesome/posawesome/ && npm run copy-html-entry",
    "build:fast": "vite build --base=/assets/posawesome/posawesome/ && npm run copy-html-entry",
    "copy-html-entry": "node scripts/copy-html-entry.mjs",
    "typecheck": "vue-tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "dexie": "^4.2.0",
    "lucide-vue-next": "^0.545.0",
    "motion-v": "^1.7.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vue-tsc": "^3.1.1"
  }
}
